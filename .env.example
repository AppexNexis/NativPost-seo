# ============================================================================
# NativPost SEO Tool — .env.local reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# After editing: pm2 restart /opt/nativpost/ecosystem.config.js --only nativpost-seo --update-env
# ============================================================================

# ── Core ─────────────────────────────────────────────────────────────────
PORT=9001
SESSION_SECRET=CHANGE-ME-run-openssl-rand-hex-32
APP_TIMEZONE=Africa/Lagos

# ── Database ──────────────────────────────────────────────────────────────
DB_HOST=69.48.201.43
DB_PORT=3307
DB_USER=nativpostseo
DB_PASSWORD=NativPostSEO123!
DB_NAME=nativpost_seo

# ── AI Engine ─────────────────────────────────────────────────────────────
# Primary: Anthropic Claude (same model as NativPost content engine)
ANTHROPIC_API_KEY=sk-ant-CHANGE-ME
ANTHROPIC_MODEL=claude-opus-4-5

# Fallback: OpenAI (optional)
# OPENAI_API_KEY=sk-CHANGE-ME
# OPENAI_MODEL=gpt-4o

# ── Contentful (publishing NativPost blog articles) ───────────────────────
# Get these from: app.contentful.com → Space Settings → API Keys
CONTENTFUL_SPACE_ID=CHANGE-ME
CONTENTFUL_ENVIRONMENT_ID=master
CONTENTFUL_CMA_TOKEN=CFPAT-CHANGE-ME
CONTENTFUL_CDA_TOKEN=CHANGE-ME
CONTENTFUL_PREVIEW_TOKEN=CHANGE-ME

# Your Contentful blog content type ID
# Go to Content model → find your blog post type → copy the ID
CONTENTFUL_BLOG_CONTENT_TYPE_ID=pageBlogPost

# Contentful field mappings — match your blog post content type's field IDs exactly
CONTENTFUL_FIELD_TITLE=title
CONTENTFUL_FIELD_SLUG=slug
CONTENTFUL_FIELD_BODY=content
CONTENTFUL_FIELD_EXCERPT=shortDescription
CONTENTFUL_FIELD_FEATURED_IMAGE=featuredImage
CONTENTFUL_FIELD_PUBLISH_DATE=publishedDate
CONTENTFUL_FIELD_AUTHOR=author
CONTENTFUL_FIELD_RELATED_POSTS=relatedBlogPosts
CONTENTFUL_FIELD_SEO_REFERENCE=seoFields
CONTENTFUL_SEO_COMPONENT_TYPE=componentSeo
CONTENTFUL_SEO_COMPONENT_FIELD_META_TITLE=pageTitle
CONTENTFUL_SEO_COMPONENT_FIELD_META_DESCRIPTION=pageDescription

# Publish mode: draft (safe) or publish (live immediately)
PUBLISH_MODE=draft
EMBED_JSONLD_IN_BODY=true

# ── DataForSEO (SERP data — reuse existing IGH subscription) ─────────────
# Same credentials as IGH SEO tool — shared account is fine
DATAFORSEO_ENABLED=true
DATAFORSEO_LOGIN=admin@infectedgamehosting.com
DATAFORSEO_PASSWORD=327a256ee462a810
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en
DATAFORSEO_DEVICE=desktop
DATAFORSEO_MAX_RESULTS=10
DATAFORSEO_CACHE_DAYS=14
DATAFORSEO_DAILY_CALL_CAP=20
DFS_BACKLINKS_MODE=sandbox

# ── Google OAuth (GSC + GA4 for nativpost.com) ────────────────────────────
# Create OAuth credentials at: console.cloud.google.com → APIs → Credentials
# Add redirect URI: https://seo.nativpost.com/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=CHANGE-ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE-ME
GOOGLE_OAUTH_REDIRECT_URI=https://seo.nativpost.com/api/auth/google/callback

# GSC property for nativpost.com (verify at search.google.com/search-console)
GSC_PROPERTY_NATIVPOST=https://nativpost.com/
GA4_PROPERTY_ID_NATIVPOST=CHANGE-ME

# ── Email (for password reset codes) ──────────────────────────────────────
# Resend recommended — free tier: 100 emails/day
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_CHANGE-ME
EMAIL_FROM_NAME=NativPost SEO
EMAIL_FROM_ADDRESS=noreply@nativpost.com

# ── Auto-publish ──────────────────────────────────────────────────────────
# Start with false — enable once Contentful is configured and tested
AUTO_PUBLISH_ENABLED=false
AUTO_PUBLISH_INTERVAL_MINUTES=10
AUTO_PUBLISH_DAILY_LIMIT=1
MIN_QUALITY_SCORE=90

# ── Crawler ───────────────────────────────────────────────────────────────
CRAWL_PAGE_LIMIT=35
SITE_HOST=nativpost.com
# CRAWL_BASE_URL=http://localhost:3000  # uncomment if crawling internal/staging

# ── NativPost Business Facts (injected into every article prompt) ─────────
# These prevent the AI from inventing wrong pricing or features
NATIVPOST_BUSINESS_FACTS=NativPost is an AI-powered social media content platform. Brands connect profiles, define voice once, and NativPost generates studio-quality posts, graphics, and videos for multiple platforms. Plans: Starter $19/mo (15 posts, 3 platforms), Growth $39/mo (40 posts, 6 platforms, video), Pro $79/mo (80 posts, unlimited platforms, human review), Agency $149/mo (unlimited posts, 5 brand profiles). All plans have a $5 one-time setup fee. 7-day free trial with 3 posts maximum, text only. Paystack accepted for African markets. Supported platforms: Instagram, Facebook, LinkedIn, Twitter/X, TikTok, Pinterest, YouTube, Threads. Content modes: Normal, Concise, Controversial. Anti-slop filter scores every post 0-1, auto-rejects below 0.7. Video formats: Slideshow, Text Motion Card, Voiceover Slideshow, UGC Ad, Data Story. AI engine: Claude (Anthropic) primary, OpenAI fallback. Do NOT claim: free forever plan, unlimited posts on Starter, 30-day trial, money-back guarantee, or any feature not listed here.

NATIVPOST_TRIAL_DAYS=7
NATIVPOST_BASE_PLAN_PRICE=19
NATIVPOST_REFUND_POLICY=NativPost offers a 7-day free trial. There is no money-back guarantee. Do not claim refunds.
NATIVPOST_PACKAGE_RULES=Starter $19 (15 posts, 3 platforms) / Growth $39 (40 posts, 6 platforms, video) / Pro $79 (80 posts, unlimited platforms) / Agency $149 (unlimited)
