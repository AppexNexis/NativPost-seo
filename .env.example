# ═══════════════════════════════════════════════════════════
# NativPost SEO Command Center — Environment Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ═══════════════════════════════════════════════════════════

# Server
PORT=7784
APP_TIMEZONE=America/New_York

# ── Database (MariaDB / MySQL) ───────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password-here
DB_NAME=nativpost_seo

# ── AI Engine (at least one required) ───────────────────────
# Primary: Anthropic Claude (recommended — same model as NativPost's engine)
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
ANTHROPIC_MODEL=claude-opus-4-5

# Fallback: OpenAI (optional)
# OPENAI_API_KEY=sk-REPLACE_ME
# OPENAI_MODEL=gpt-4o

# ── Security ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX

# ── NativPost URLs ────────────────────────────────────────────
NATIVPOST_SITE_URL=https://nativpost.com
NATIVPOST_APP_URL=https://app.nativpost.com

# ── DataForSEO (optional — falls back to DuckDuckGo) ─────────
# Sign up at dataforseo.com — ~$0.0025/SERP call
# DATAFORSEO_LOGIN=your@email.com
# DATAFORSEO_PASSWORD=your-dfs-password
# DATAFORSEO_LOCATION_CODE=2840
# DATAFORSEO_LANGUAGE_CODE=en
# DATAFORSEO_DEVICE=desktop
# DATAFORSEO_MAX_RESULTS=10
# DATAFORSEO_CACHE_DAYS=14
DATAFORSEO_DAILY_CALL_CAP=20

# ── Content Quality & Publishing ──────────────────────────────
# Articles scoring below MIN_QUALITY_SCORE stay as Draft
# Articles at or above go to Pending Review automatically
MIN_QUALITY_SCORE=90

# Auto-publisher: publishes approved articles automatically
AUTO_PUBLISH_ENABLED=false
AUTO_PUBLISH_DAILY_LIMIT=1
AUTO_PUBLISH_INTERVAL_MINUTES=10

# ── NativPost Business Facts Override (optional) ──────────────
# Uncomment and edit to customize the AI's knowledge of NativPost
# NATIVPOST_BUSINESS_FACTS=NativPost is an AI-powered social media content platform...

# ── Crawl override (optional) ─────────────────────────────────
# Use if nativpost.com isn't live yet or you want to crawl staging
# CRAWL_BASE_URL=http://localhost:3000
