<%- include('layout-start') %>

<section class="hero">
  <p class="eyebrow">Content</p>
  <h1>Content Studio</h1>
  <p>Generate high-quality SEO articles for NativPost using AI. Targets real keyword gaps and outranks competitors.</p>
</section>

<% if (typeof query !== 'undefined' && query && query.error) { %>
<div class="alert bad">⚠️ Generation failed: <%= query.error %></div>
<% } %>

<div class="grid two" style="align-items:start">

  <!-- GENERATE PANEL -->
  <section class="card">
    <div class="card-head"><h2>✍️ Generate Article</h2></div>

    <form method="post" action="/content-studio/generate" id="gen-form">
      <div class="form-group">
        <label>Target keyword *</label>
        <input type="text" name="keyword" id="kw-input" value="<%= typeof query !== 'undefined' && query.keyword ? query.keyword : '' %>" placeholder="e.g. ai social media content generator" required>
        <div class="hint" style="margin-top:4px">The primary keyword this article will target. Be specific.</div>
      </div>

      <div class="form-group">
        <label>Target word count</label>
        <select name="word_target">
          <option value="1000">~1,000 words (quick article)</option>
          <option value="1400" selected>~1,400 words (standard)</option>
          <option value="2000">~2,000 words (in-depth)</option>
          <option value="2500">~2,500 words (comprehensive)</option>
          <option value="3000">~3,000 words (pillar page)</option>
        </select>
      </div>

      <div class="form-group">
        <label>Article type (auto-detected from keyword)</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px">
          <div class="hint" style="padding:8px;background:var(--bg-2);border-radius:6px;border:1px solid var(--line)">
            <strong style="color:var(--np-purple);font-size:.75rem">AUTO-DETECTED</strong><br>
            The tool detects if your keyword is a comparison (vs/alternative), pricing review, how-to, Africa-market, platform-specific, or general article and applies the right structure automatically.
          </div>
          <div class="hint" style="padding:8px;background:var(--bg-2);border-radius:6px;border:1px solid var(--line)">
            <strong style="color:var(--good);font-size:.75rem">QUALITY GATE</strong><br>
            Articles scoring below <%= minQualityScore %>/100 go to Draft. Above <%= minQualityScore %> goes to Pending Review automatically.
          </div>
        </div>
      </div>

      <button type="submit" class="primary" onclick="this.textContent='⏳ Generating… (30-60s)';this.disabled=true;document.getElementById('gen-form').submit();" style="width:100%">
        Generate Article →
      </button>
      <div class="hint" style="text-align:center;margin-top:8px">Uses Anthropic Claude API · ~30-60 seconds · 1 API call</div>
    </form>

    <div style="border-top:1px solid var(--line-soft);margin-top:var(--sp-4);padding-top:var(--sp-4)">
      <div class="card-head" style="margin-bottom:var(--sp-3)"><h2 style="font-size:.9rem">💡 Article Type Guide</h2></div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <% var types = [
          {signal:'vs / alternative / compare', type:'Comparison', desc:'Head-to-head vs Ocoya, Buffer, Jasper with feature matrix'},
          {signal:'pricing / cost / review / worth it', type:'Pricing Review', desc:'Full plan breakdown with conversion-optimized tables'},
          {signal:'how to / guide / tutorial', type:'How-To Guide', desc:'Step-by-step instructional with NativPost CTA'},
          {signal:'africa / nigeria / kenya / ghana', type:'Africa Market', desc:'Localized for African SMBs + Paystack angle'},
          {signal:'linkedin / instagram / tiktok / twitter', type:'Platform Guide', desc:'Platform-specific content strategy + NativPost feature'},
          {signal:'best / top N / tools for', type:'Listicle', desc:'Ranked comparison with NativPost positioning'},
        ]; %>
        <% types.forEach(function(t) { %>
        <div style="display:flex;gap:10px;align-items:flex-start;padding:8px;background:var(--bg-2);border-radius:6px;border:1px solid var(--line-soft)">
          <div style="flex-shrink:0;font-family:var(--mono);font-size:.68rem;color:var(--np-purple);background:var(--np-purple-soft);padding:2px 6px;border-radius:4px;white-space:nowrap"><%= t.signal %></div>
          <div>
            <div style="font-size:.78rem;font-weight:700;color:var(--text-heading)"><%= t.type %></div>
            <div style="font-size:.72rem;color:var(--text-muted)"><%= t.desc %></div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- KEYWORD SUGGESTIONS -->
  <div>
    <section class="card" style="margin-bottom:var(--sp-4)">
      <div class="card-head"><h2>🎯 Suggested Keywords</h2><a href="/keywords">All keywords →</a></div>
      <p class="hint" style="margin-bottom:var(--sp-3)">Keywords with no article yet, sorted by priority. Click to pre-fill.</p>

      <div class="pill-row" style="margin-bottom:var(--sp-3)">
        <% clusters.forEach(function(c) { %>
        <a href="/content-studio?cluster=<%= c.key %>" class="pill <%= typeof query !== 'undefined' && query.cluster === c.key ? 'active' : '' %>"><%= c.label %></a>
        <% }); %>
        <a href="/content-studio" class="pill <%= !( typeof query !== 'undefined' && query.cluster) ? 'active' : '' %>">All</a>
      </div>

      <% var filtered = keywords.filter(function(k){ return !k.has_article && (!(typeof query !== 'undefined' && query.cluster) || k.cluster_key === (query && query.cluster)); }).slice(0,20); %>
      <% if (!filtered.length) { %>
        <p class="empty">No uncovered keywords in this cluster. <a href="/keywords" style="color:var(--np-purple)">Add more →</a></p>
      <% } %>
      <div style="display:flex;flex-direction:column;gap:6px">
        <% filtered.forEach(function(k) { %>
        <div style="display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--bg-2);border-radius:6px;border:1px solid var(--line-soft);cursor:pointer" onclick="document.getElementById('kw-input').value='<%= k.keyword.replace(/'/g, "\\'") %>';window.scrollTo(0,0)">
          <div style="flex:1;min-width:0">
            <div style="font-size:.84rem;font-weight:600;color:var(--text)"><%= k.keyword %></div>
            <div style="font-size:.7rem;color:var(--text-muted)"><%= k.cluster_name||'Unclustered' %> · <%= k.intent||'mixed' %><% if(k.volume){%> · Vol <%= k.volume %><% } %></div>
          </div>
          <div style="font-size:.7rem;font-weight:700;color:var(--np-purple)">Prio <%= k.priority_score||50 %></div>
          <div style="font-size:.7rem;color:var(--text-dim)">→</div>
        </div>
        <% }); %>
      </div>
    </section>

    <!-- GENERATION TIPS -->
    <section class="card">
      <div class="card-head"><h2>✅ Content Rules</h2></div>
      <div style="display:flex;flex-direction:column;gap:6px">
        <% var rules = [
          {ok:true, text:'Opens with scenario/pain point, not a definition'},
          {ok:true, text:'First element = comparison/summary table (featured snippet bait)'},
          {ok:true, text:'Includes "2026" in title or first H2'},
          {ok:true, text:'3-5 internal links to nativpost.com/blog/'},
          {ok:true, text:'1 external link to credible third party'},
          {ok:true, text:'Paystack angle included for Africa-market keywords'},
          {ok:true, text:'No invented features or false pricing claims'},
          {ok:true, text:'Anti-slop filter removes: leverage, synergy, disruptive, game-changing'},
          {ok:true, text:'CTA ends with app.nativpost.com 7-day free trial'},
          {ok:true, text:'FAQ section with self-contained answers (AI Overview bait)'},
        ]; %>
        <% rules.forEach(function(r) { %>
        <div style="display:flex;align-items:flex-start;gap:8px;font-size:.78rem;color:var(--text-muted)">
          <span style="color:var(--good);flex-shrink:0">✓</span>
          <%= r.text %>
        </div>
        <% }); %>
      </div>
    </section>
  </div>
</div>

<%- include('layout-end') %>
