<%- include('layout-start') %>
<section class="hero">
  <div>
    <p class="eyebrow">Keyword strategy</p>
    <h1>Keywords</h1>
    <p>Search phrases driving your SEO strategy. Keywords from GSC sync carry real impression and position data. Competitor crawls surface gap opportunities.</p>
  </div>
  <div class="actions">
    <a class="btn" href="/serp">Research keywords →</a>
    <form method="post" action="/keywords/cluster"><button class="btn primary">Recluster / rescore all</button></form>
  </div>
</section>

<div class="grid two">
  <section class="card">
    <h2>Add keyword manually</h2>
    <form class="stack" method="post" action="/keywords">
      <label>Site
        <select name="site_id">
          <option value="">No site</option>
          <% sites.forEach(function(s){ %><option value="<%= s.id %>"><%= s.name %></option><% }); %>
        </select>
      </label>
      <label>Keyword<input name="keyword" placeholder="minecraft server hosting" required></label>
      <div class="grid two" style="gap:8px">
        <label>Cluster<input name="cluster_name" placeholder="Auto if blank"></label>
        <label>Volume<input name="volume" type="number" placeholder="Monthly searches"></label>
        <label>Difficulty (0-100)<input name="difficulty" type="number" step="0.1" placeholder="35"></label>
        <label>Intent
          <select name="intent">
            <option value="">Auto-detect</option>
            <option value="commercial">Commercial</option>
            <option value="informational">Informational</option>
            <option value="transactional">Transactional</option>
          </select>
        </label>
      </div>
      <button class="btn primary">Add keyword</button>
    </form>
  </section>

  <section class="card">
    <h2>Keyword summary</h2>
    <%
      var _total = keywords.length;
      var _withVol = keywords.filter(function(k){ return Number(k.volume||0) > 0; }).length;
      var _fromGSC = keywords.filter(function(k){ return k.source==='gsc'; }).length;
      var _fromComp = keywords.filter(function(k){ return k.source==='competitor-crawl'; }).length;
      var _commercial = keywords.filter(function(k){ return k.intent==='commercial'; }).length;
      var _informational = keywords.filter(function(k){ return k.intent==='informational'; }).length;
      var _clusters = {};
      keywords.forEach(function(k){ if(k.cluster_name){ _clusters[k.cluster_name] = (_clusters[k.cluster_name]||0)+1; } });
      var _clusterCount = Object.keys(_clusters).length;
    %>
    <div class="stats" style="margin:0;grid-template-columns:repeat(3,1fr)">
      <div><b><%= _total %></b><span>Total keywords</span></div>
      <div><b><%= _clusterCount %></b><span>Topic clusters</span></div>
      <div><b><%= _withVol %></b><span>With volume data</span></div>
      <div><b><%= _fromGSC %></b><span>From GSC</span></div>
      <div><b><%= _fromComp %></b><span>From competitors</span></div>
      <div><b><%= _commercial %></b><span>Commercial intent</span></div>
    </div>
    <% if(!_fromGSC){ %>
      <div class="notice-warn" style="margin-top:.75rem;font-size:var(--fs-sm)"><strong>No GSC keywords.</strong> Connect Google in <a href="/settings">Settings</a> and sync to get real ranking data.</div>
    <% } %>
  </section>
</div>

<!-- TOPIC CLUSTERS -->
<% if(_clusterCount > 0){ %>
<section class="card">
  <div class="card-head"><h2>Topic clusters</h2><span class="badge"><%= _clusterCount %> clusters</span></div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px">
    <% Object.entries(_clusters).sort(function(a,b){ return b[1]-a[1]; }).slice(0,24).forEach(function(entry){ %>
      <div style="background:var(--bg-2);border:1px solid var(--line);border-radius:var(--r-md);padding:12px">
        <strong style="font-size:var(--fs-md)"><%= entry[0] %></strong>
        <span style="display:block;color:var(--text-muted);font-size:var(--fs-sm);margin-top:2px"><%= entry[1] %> keyword<%= entry[1]===1?'':'s' %></span>
      </div>
    <% }); %>
  </div>
</section>
<% } %>

<!-- KEYWORD TABLE -->
<section class="card">
  <div class="card-head"><h2>All keywords (<%= keywords.length %>)</h2></div>
  <% if(!keywords.length){ %>
    <p class="empty">No keywords yet. Add one above, run competitor crawls, or connect GSC for real ranking data.</p>
  <% } else { %>
    <table style="width:100%;border-collapse:collapse;font-size:var(--fs-sm)">
      <thead><tr style="border-bottom:1px solid var(--line);text-align:left">
        <th style="padding:.3rem .5rem">Keyword</th>
        <th style="padding:.3rem .5rem">Cluster</th>
        <th style="padding:.3rem .5rem">Intent</th>
        <th style="padding:.3rem .5rem">Priority</th>
        <th style="padding:.3rem .5rem">Volume</th>
        <th style="padding:.3rem .5rem">Difficulty</th>
        <th style="padding:.3rem .5rem">Source</th>
        <th style="padding:.3rem .5rem">Site</th>
      </tr></thead>
      <tbody>
      <% keywords.forEach(function(k){ %>
        <tr style="border-bottom:1px solid var(--line)">
          <td style="padding:.35rem .5rem"><strong><%= k.keyword %></strong></td>
          <td style="padding:.35rem .5rem;color:var(--text-muted)"><%= k.cluster_name||'—' %></td>
          <td style="padding:.35rem .5rem">
            <span style="font-size:var(--fs-sm);padding:2px 7px;border-radius:var(--r-sm);background:<%= k.intent==='commercial'?'rgba(0, 230, 118, 0.12)':k.intent==='transactional'?'rgba(34,197,94,.15)':'var(--line)' %>">
              <%= k.intent||'mixed' %>
            </span>
          </td>
          <td style="padding:.35rem .5rem"><b><%= k.priority_score||0 %></b></td>
          <td style="padding:.35rem .5rem"><%= k.volume||'—' %></td>
          <td style="padding:.35rem .5rem"><%= k.difficulty||'—' %></td>
          <td style="padding:.35rem .5rem;color:var(--text-muted);font-size:var(--fs-sm)"><%= k.source||'manual' %></td>
          <td style="padding:.35rem .5rem;color:var(--text-muted)"><%= k.site_name||'—' %></td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  <% } %>
</section>
<%- include('layout-end') %>
