<%- include('layout-start') %>
<% if(typeof query !== 'undefined' && query && query.generating){ %>
<div style="background:rgba(34,255,68,.08);border:1px solid rgba(34,255,68,.25);border-radius:10px;padding:14px 20px;margin-bottom:1rem;display:flex;align-items:center;gap:12px">
  <div style="width:18px;height:18px;border:2px solid var(--igh-green);border-top-color:transparent;border-radius:50%;animation:spin 0.8s linear infinite;flex-shrink:0"></div>
  <div>
    <strong style="color:var(--igh-green)">Generating article...</strong>
    <span style="color:var(--text-muted);font-size:.85rem"> &nbsp;Topic: "<%= query.generating %>" — this takes 60-90 seconds. The draft will appear below automatically.</span>
  </div>
  <script>setTimeout(function(){ location.reload(); }, 15000);</script>
</div>
<style>@keyframes spin{to{transform:rotate(360deg)}}</style>
<% } %>
<section class="hero">
  <div>
    <p class="eyebrow">Content inventory</p>
    <h1>Drafts &amp; Articles</h1>
    <p>All articles in every status. Edit, preview, approve, queue, or delete from here.</p>
  </div>
  <div class="actions">
    <a class="btn primary" href="/articles/new">New draft</a>
    <form method="post" action="/articles/repair-images"><button class="btn">Repair missing images</button></form>
    <form method="post" action="/articles/delete-drafts" onsubmit="return confirm('Delete ALL draft, review, and rejected articles? Published and queued articles are NOT deleted.')">
      <button class="btn danger">Delete all drafts</button>
    </form>
  </div>
</section>

<div class="tabs">
  <a class="<%= !status?'active':'' %>" href="/articles">All</a>
  <a class="<%= status==='draft'?'active':'' %>" href="/articles?status=draft">Drafts</a>
  <a class="<%= status==='review'?'active':'' %>" href="/articles?status=review">Review</a>
  <a class="<%= status==='approved'?'active':'' %>" href="/articles?status=approved">Approved</a>
  <a class="<%= status==='queued'?'active':'' %>" href="/articles?status=queued">Queued</a>
  <a class="<%= status==='published'?'active':'' %>" href="/articles?status=published">Published</a>
</div>

<% if (message) { %><section class="card notice"><%= message %></section><% } %>

<section class="card">
  <% if(!articles.length){ %>
    <p class="empty">No articles found<%= status ? ' with status "'+status+'"' : '' %>.</p>
  <% } %>
  <% articles.forEach(a=>{ %>
    <div class="article-row">
      <% if(a.featured_image_url){ %>
        <img src="<%= a.featured_image_url %>" alt="" onerror="this.style.display='none'">
      <% } else { %>
        <div class="thumb">No image</div>
      <% } %>
      <div>
        <strong><a href="/articles/<%= a.id %>/edit"><%= a.title %></a></strong>
        <span>
          <%= a.site_name || 'No site' %> &middot;
          <%= a.status %> &middot;
          <%= a.primary_keyword || 'No keyword' %> &middot;
          Quality <b><%= a.quality_score || 0 %></b>/<%= minQualityScore %>
        </span>
        <% if (a.status === 'queued' || a.status === 'approved') { %>
          <p class="schedule-line"><strong><%= schedulePublishLabel(a) %></strong></p>
        <% } %>
        <% if (a.status === 'published') { %>
          <p class="schedule-line"><strong><%= publishedLabel(a) %></strong></p>
        <% } %>
        <% if (a.meta_description) { %><p style="font-size:var(--fs-sm);color:#888;"><%= a.meta_description.slice(0,160) %></p><% } %>
      </div>
      <div class="actions">
        <a class="mini" href="/articles/<%= a.id %>">Preview</a>
        <a class="mini" href="/articles/<%= a.id %>/edit">Edit</a>
        <form method="post" action="/articles/<%= a.id %>/delete" onsubmit="return confirm('Delete this article permanently?')">
          <button class="mini danger">Delete</button>
        </form>
      </div>
    </div>
  <% }) %>
</section>
<%- include('layout-end') %>
