<%- include('layout-start') %>
<section class="hero">
  <div>
    <p class="eyebrow">Editorial review</p>
    <h1>Review Queue</h1>
    <p>Articles land here after generation. Check quality scores and notes — articles below <strong><%= minQualityScore %></strong> are blocked from publishing automatically.</p>
  </div>
  <div class="actions">
    <form method="post" action="/review/approve-ready">
      <button class="btn primary">Approve all above threshold (<%= minQualityScore %>)</button>
    </form>
    <form method="post" action="/articles/regenerate-low-quality" onsubmit="return confirm('Reject all drafts below quality threshold and regenerate? Uses 1 OpenAI credit per article.')">
      <button class="btn">Regenerate below threshold</button>
    </form>
    <form method="post" action="/articles/delete-drafts" onsubmit="return confirm('Delete ALL draft and review articles? Published and queued articles are not affected.')">
      <button class="btn danger">Delete all drafts</button>
    </form>
  </div>
</section>

<%
  var _ready = (typeof articles !== 'undefined') ? articles.filter(function(a){ return Number(a.quality_score||0) >= minQualityScore; }) : [];
  var _needs = (typeof articles !== 'undefined') ? articles.filter(function(a){ return Number(a.quality_score||0) < minQualityScore; }) : [];
%>

<% if(articles && articles.length){ %>
<div class="review-summary">
  <div class="review-stat good"><strong><%= _ready.length %></strong><span>Ready to approve</span></div>
  <div class="review-stat warn"><strong><%= _needs.length %></strong><span>Below threshold</span></div>
  <div class="review-stat"><strong><%= articles.length %></strong><span>Total in queue</span></div>
</div>
<% } %>

<section class="card">
  <% if(!articles || !articles.length){ %>
    <p class="empty">No drafts waiting for review. Generate articles from Content Studio to get started.</p>
  <% } %>
  <% articles && articles.forEach(function(a){ %>
    <%
      var _q = Number(a.quality_score || 0);
      var _pass = _q >= minQualityScore;
    %>
    <div class="article-row" style="border-left: 3px solid <%= _pass ? 'var(--good,var(--igh-green))' : 'var(--bad,var(--bad))' %>; padding-left: 12px;">
      <% if(a.featured_image_url){ %>
        <img src="<%= a.featured_image_url %>" alt="" onerror="this.style.display='none'">
      <% } else { %>
        <div class="thumb">No image</div>
      <% } %>
      <div>
        <strong><a href="/articles/<%= a.id %>/edit"><%= a.title %></a></strong>
        <span>
          <%= a.site_name || 'No site' %> &middot;
          <%= a.primary_keyword || 'No keyword' %> &middot;
          Status: <b><%= a.status %></b> &middot;
          Quality: <b style="color:<%= _pass ? 'var(--good,var(--igh-green))' : 'var(--bad,var(--bad))' %>"><%= _q %></b>/<%= minQualityScore %>
          <%= _pass ? ' ✓ ready' : ' ✗ needs work' %>
        </span>
        <% if(a.review_notes){ %>
          <div class="quality-notes"><%= a.review_notes.slice(0,500) %></div>
        <% } %>
      </div>
      <div class="actions">
        <a class="mini" href="/articles/<%= a.id %>">Preview</a>
        <a class="mini" href="/articles/<%= a.id %>/edit">Edit</a>
        <form method="post" action="/articles/<%= a.id %>/status">
          <% if(!_pass){ %>
            <button class="mini" name="status" value="approved"
              onclick="return confirm('Quality score ' + <%= _q %> + '/' + <%= minQualityScore %> + ' is below threshold. Approve anyway? It will be blocked at publish time if still below threshold.')">
              Approve anyway
            </button>
          <% } else { %>
            <button class="mini primary" name="status" value="approved">Approve ✓</button>
          <% } %>
        </form>
        <form method="post" action="/articles/<%= a.id %>/reject-regenerate" onsubmit="return confirm('Reject and regenerate this article? Uses 1 OpenAI credit.')">
          <button class="mini">Reject + regen</button>
        </form>
        <form method="post" action="/articles/<%= a.id %>/delete" onsubmit="return confirm('Delete this draft permanently?')">
          <button class="mini danger">Delete</button>
        </form>
      </div>
    </div>
  <% }); %>
</section>
<%- include('layout-end') %>
