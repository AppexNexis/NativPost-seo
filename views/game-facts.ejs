<%- include('layout-start') %>
<section class="hero">
  <div>
    <p class="eyebrow">Game Knowledge Base</p>
    <h1>Brand Facts</h1>
    <p>These facts are injected at the very top of every article prompt as the highest-priority instruction. The AI <strong>must</strong> use these exactly — it cannot override them with training data. Keep them accurate and up to date.</p>
  </div>
</section>

<% if(typeof msg !== 'undefined' && msg){ %>
  <div class="notice-good"><%= msg %></div>
<% } %>

<div class="notice-warn" style="font-size:var(--fs-sm)">
  <strong>How this fixes "wrong player counts":</strong> Before this system, the AI relied on its training data which may be months old or simply wrong for new games like Windrose. Now these facts appear <em>before everything else</em> in the prompt with explicit instruction: "Do NOT adjust based on your training data." After updating facts here, regenerate any affected articles.
</div>

<% (facts||[]).forEach(function(f){ %>
<section class="card" style="margin-bottom:1rem">
  <div class="card-head">
    <h2><%= f.game_key.charAt(0).toUpperCase()+f.game_key.slice(1) %></h2>
    <span style="font-size:var(--fs-sm);padding:2px 10px;border-radius:var(--r-sm);background:<%= f.dedicated_server_available?'rgba(34,197,94,.15)':'rgba(239,68,68,.12)' %>;color:<%= f.dedicated_server_available?'var(--np-purple)':'var(--bad)' %>">
      <%= f.dedicated_server_available ? '✓ Dedicated servers available' : '✗ No dedicated servers yet' %>
    </span>
  </div>
  <form method="post" action="/admin/game-facts/<%= f.game_key %>/update" class="stack">
    <div class="grid two" style="gap:10px">
      <label>Max players (hard limit)<input name="max_players" type="number" value="<%= f.max_players||'' %>" placeholder="e.g. 8"></label>
      <label>Min RAM (GB)<input name="ram_min_gb" type="number" value="<%= f.ram_min_gb||'' %>" placeholder="e.g. 8"></label>
      <label>RAM breakdown notes<input name="ram_notes" value="<%= f.ram_notes||'' %>" placeholder="e.g. 8GB for 2 players, 16GB for 8 players"></label>
      <label>Game engine<input name="engine" value="<%= f.engine||'' %>" placeholder="e.g. Unreal Engine 5"></label>
      <label>Server OS<input name="server_os" value="<%= f.server_os||'' %>" placeholder="e.g. Windows, Linux"></label>
      <label>SteamCMD App ID<input name="steamcmd_app_id" value="<%= f.steamcmd_app_id||'' %>" placeholder="e.g. 3041230"></label>
      <label>Official website<input name="official_site" value="<%= f.official_site||'' %>"></label>
      <label>Steam page URL<input name="steam_url" value="<%= f.steam_url||'' %>"></label>
      <label>Release status<select name="release_status"><option value="released" <%=f.release_status==='released'?'selected':''%>>Released</option><option value="early_access" <%=f.release_status==='early_access'?'selected':''%>>Early Access</option><option value="unreleased" <%=f.release_status==='unreleased'?'selected':''%>>Not released yet</option></select></label>
      <label>Release date<input name="release_date" value="<%= f.release_date||'' %>" placeholder="e.g. April 2026"></label>
      <label>Dedicated servers exist?<select name="dedicated_server_available"><option value="1" <%=f.dedicated_server_available?'selected':''%>>Yes — hosting is possible</option><option value="0" <%=!f.dedicated_server_available?'selected':''%>>No — write anticipation content only</option></select></label>
    </div>
    <label style="margin-top:8px">Extra notes for AI (shown verbatim in prompt)
      <textarea name="custom_facts" rows="2" style="width:100%"><%= f.custom_facts||'' %></textarea>
    </label>
    <button class="btn primary" style="width:auto">Save <%= f.game_key %> facts</button>
  </form>
  <div style="margin-top:.5rem;font-size:var(--fs-xs);color:var(--text-muted)">Updated: <%= f.updated_at ? new Date(f.updated_at).toLocaleString() : 'Never' %></div>
</section>
<% }); %>
<%- include('layout-end') %>
