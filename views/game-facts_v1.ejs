<%- include('layout-start') %>

<section class="hero">
  <div>
    <p class="eyebrow">Game Knowledge Base</p>
    <h1>Brand Facts</h1>
    <p>These facts are injected at the very top of every article prompt. The AI must use these exactly and cannot override them with training data.</p>
  </div>
</section>

<div class="grid two" style="align-items:start">

  <section class="card">
    <div class="card-head" style="margin-bottom:var(--sp-4)"><h2>NativPost Core Facts</h2></div>
    <div style="background:rgba(245,166,35,.08);border:1px solid rgba(245,166,35,.2);border-radius:8px;padding:12px 14px;margin-bottom:var(--sp-4)">
      <div style="font-size:.75rem;font-weight:700;color:var(--warn);margin-bottom:4px">How this prevents wrong pricing in articles</div>
      <div style="font-size:.75rem;color:var(--text-muted);line-height:1.6">These facts appear before everything else in the prompt with instruction: Do NOT adjust based on training data. After updating facts, regenerate any affected articles.</div>
    </div>
    <div style="display:flex;flex-direction:column;gap:var(--sp-3)">
      <div style="padding:12px;background:var(--bg-2);border-radius:8px;border:1px solid var(--line)">
        <div style="font-size:.75rem;font-weight:700;color:var(--igh-green);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Plans</div>
        <div style="font-size:.82rem;color:var(--text);line-height:1.6">Starter $19/mo (15 posts, 3 platforms) &middot; Growth $39/mo (40 posts, 6 platforms, video) &middot; Pro $79/mo (80 posts, unlimited platforms) &middot; Agency $149/mo (unlimited, 5 brand profiles)</div>
      </div>
      <div style="padding:12px;background:var(--bg-2);border-radius:8px;border:1px solid var(--line)">
        <div style="font-size:.75rem;font-weight:700;color:var(--igh-green);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Setup fee</div>
        <div style="font-size:.82rem;color:var(--text);line-height:1.6">$5 one-time setup fee on all plans.</div>
      </div>
      <div style="padding:12px;background:var(--bg-2);border-radius:8px;border:1px solid var(--line)">
        <div style="font-size:.75rem;font-weight:700;color:var(--igh-green);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Free trial</div>
        <div style="font-size:.82rem;color:var(--text);line-height:1.6">7-day free trial. 3 posts maximum, text only. No credit card required.</div>
      </div>
      <div style="padding:12px;background:var(--bg-2);border-radius:8px;border:1px solid var(--line)">
        <div style="font-size:.75rem;font-weight:700;color:var(--igh-green);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Refund policy</div>
        <div style="font-size:.82rem;color:var(--text);line-height:1.6">No money-back guarantee. 7-day trial lets customers test before paying.</div>
      </div>
      <div style="padding:12px;background:var(--bg-2);border-radius:8px;border:1px solid var(--line)">
        <div style="font-size:.75rem;font-weight:700;color:var(--igh-green);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">AI engine</div>
        <div style="font-size:.82rem;color:var(--text);line-height:1.6">Anthropic Claude (primary) with OpenAI as fallback. Anti-slop filter scores every post 0-1, auto-rejects below 0.7.</div>
      </div>
      <div style="padding:12px;background:var(--bg-2);border-radius:8px;border:1px solid var(--line)">
        <div style="font-size:.75rem;font-weight:700;color:var(--igh-green);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Content modes</div>
        <div style="font-size:.82rem;color:var(--text);line-height:1.6">Normal &middot; Concise (max 3 sentences) &middot; Controversial (strategic provocation)</div>
      </div>
      <div style="padding:12px;background:var(--bg-2);border-radius:8px;border:1px solid var(--line)">
        <div style="font-size:.75rem;font-weight:700;color:var(--igh-green);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Platforms</div>
        <div style="font-size:.82rem;color:var(--text);line-height:1.6">Instagram, Facebook, LinkedIn, LinkedIn Pages, Twitter/X, TikTok, YouTube, Threads, Pinterest</div>
      </div>
      <div style="padding:12px;background:var(--bg-2);border-radius:8px;border:1px solid var(--line)">
        <div style="font-size:.75rem;font-weight:700;color:var(--igh-green);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Video formats</div>
        <div style="font-size:.82rem;color:var(--text);line-height:1.6">Slideshow &middot; Text Motion Card &middot; Voiceover Slideshow &middot; UGC Ad &middot; Data Story</div>
      </div>
      <div style="padding:12px;background:var(--bg-2);border-radius:8px;border:1px solid var(--line)">
        <div style="font-size:.75rem;font-weight:700;color:var(--igh-green);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Africa billing</div>
        <div style="font-size:.82rem;color:var(--text);line-height:1.6">Paystack accepted. The only AI social media tool with native African market billing support.</div>
      </div>
      <div style="padding:12px;background:var(--bg-2);border-radius:8px;border:1px solid var(--line)">
        <div style="font-size:.75rem;font-weight:700;color:var(--igh-green);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Brand voice config</div>
        <div style="font-size:.82rem;color:var(--text);line-height:1.6">Tone sliders 1-10 (formality/humor/energy), forbidden words, per-platform voice, content examples, anti-patterns, topic memory.</div>
      </div>
      <div style="padding:12px;background:var(--bg-2);border-radius:8px;border:1px solid var(--line)">
        <div style="font-size:.75rem;font-weight:700;color:var(--igh-green);text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px">Generation</div>
        <div style="font-size:.82rem;color:var(--text);line-height:1.6">3 variants generated in parallel. Cross-variant deduplication. Feedback loop improves per brand.</div>
      </div>
    </div>
  </section>

  <div>
    <section class="card" style="margin-bottom:var(--sp-4)">
      <div class="card-head" style="margin-bottom:var(--sp-4)"><h2>Competitor Intelligence</h2></div>
      <p style="font-size:var(--fs-sm);color:var(--text-muted);margin-bottom:var(--sp-3)">Direct competitors referenced in comparison articles. Pre-loaded and kept current by the competitor auditor.</p>
      <div style="padding:10px 12px;border-top:1px solid var(--line-soft);display:flex;gap:10px;align-items:flex-start">
        <div style="min-width:90px"><div style="font-size:.82rem;font-weight:700;color:var(--text-heading)">Ocoya</div><span class="badge bad" style="margin-top:3px">Direct</span></div>
        <div style="font-size:.75rem;color:var(--text-muted);line-height:1.5">Content creation and scheduling. DM chatbots, RSS triggers, design tool. $15-$159/mo.</div>
      </div>
      <div style="padding:10px 12px;border-top:1px solid var(--line-soft);display:flex;gap:10px;align-items:flex-start">
        <div style="min-width:90px"><div style="font-size:.82rem;font-weight:700;color:var(--text-heading)">Predis.ai</div><span class="badge bad" style="margin-top:3px">Direct</span></div>
        <div style="font-size:.75rem;color:var(--text-muted);line-height:1.5">AI social content. Autopost often ignores brief. No anti-slop filtering.</div>
      </div>
      <div style="padding:10px 12px;border-top:1px solid var(--line-soft);display:flex;gap:10px;align-items:flex-start">
        <div style="min-width:90px"><div style="font-size:.82rem;font-weight:700;color:var(--text-heading)">Buffer</div><span class="badge warn" style="margin-top:3px">Scheduler</span></div>
        <div style="font-size:.75rem;color:var(--text-muted);line-height:1.5">Scheduling-first. Basic AI caption bolt-on. No real generation engine.</div>
      </div>
      <div style="padding:10px 12px;border-top:1px solid var(--line-soft);display:flex;gap:10px;align-items:flex-start">
        <div style="min-width:90px"><div style="font-size:.82rem;font-weight:700;color:var(--text-heading)">Hootsuite</div><span class="badge" style="margin-top:3px">Enterprise</span></div>
        <div style="font-size:.75rem;color:var(--text-muted);line-height:1.5">Enterprise scheduling. $99+/mo. Superficial AI features.</div>
      </div>
      <div style="padding:10px 12px;border-top:1px solid var(--line-soft);display:flex;gap:10px;align-items:flex-start">
        <div style="min-width:90px"><div style="font-size:.82rem;font-weight:700;color:var(--text-heading)">Jasper</div><span class="badge" style="margin-top:3px">Writing</span></div>
        <div style="font-size:.75rem;color:var(--text-muted);line-height:1.5">Best brand voice AI writing. No scheduling, no video. $59+/user/mo.</div>
      </div>
      <div style="padding:10px 12px;border-top:1px solid var(--line-soft);display:flex;gap:10px;align-items:flex-start">
        <div style="min-width:90px"><div style="font-size:.82rem;font-weight:700;color:var(--text-heading)">Later</div><span class="badge warn" style="margin-top:3px">Scheduler</span></div>
        <div style="font-size:.75rem;color:var(--text-muted);line-height:1.5">Instagram-first scheduler. Limited AI. Good visual calendar.</div>
      </div>
      <div style="padding:10px 12px;border-top:1px solid var(--line-soft);display:flex;gap:10px;align-items:flex-start">
        <div style="min-width:90px"><div style="font-size:.82rem;font-weight:700;color:var(--text-heading)">FeedHive</div><span class="badge bad" style="margin-top:3px">Direct</span></div>
        <div style="font-size:.75rem;color:var(--text-muted);line-height:1.5">AI writing and scheduling. Strong for LinkedIn. Limited video.</div>
      </div>
    </section>

    <section class="card">
      <div class="card-head" style="margin-bottom:var(--sp-4)"><h2>Anti-Slop Banned Words</h2></div>
      <p style="font-size:var(--fs-sm);color:var(--text-muted);margin-bottom:var(--sp-3)">Banned from all generated articles. Quality scorer penalizes their use.</p>
      <div style="display:flex;flex-wrap:wrap;gap:6px">
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">leverage</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">synergy</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">disruptive</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">game-changing</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">cutting-edge</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">robust</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">seamlessly</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">holistic</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">revolutionize</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">transformative</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">innovative</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">streamline</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">empower</span>
        <span style="padding:3px 10px;background:rgba(255,79,106,.1);border:1px solid rgba(255,79,106,.2);border-radius:999px;font-size:.72rem;color:var(--bad);font-family:var(--mono)">unlock</span>
      </div>
    </section>
  </div>

</div>

<%- include('layout-end') %>
