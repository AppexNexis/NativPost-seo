<%- include('layout-start') %>
<section class="hero"><div><p class="eyebrow"><%= article.status %> article · quality <%= article.quality_score || 0 %></p><h1><%= article.title %></h1><p><%= article.primary_keyword || 'No primary keyword' %> · <%= article.site_name || 'No site selected' %></p></div><div class="actions"><a class="btn primary" href="/articles/<%= article.id %>/edit">Edit Draft</a><form method="post" action="/articles/<%= article.id %>/status"><button name="status" value="review" class="btn">Review</button></form><form method="post" action="/articles/<%= article.id %>/status"><button name="status" value="approved" class="btn">Approve</button></form><form method="post" action="/articles/<%= article.id %>/status"><button name="status" value="queued" class="btn">Queue</button></form></div></section>
<div class="grid two"><section class="card"><h2>SEO fields</h2><div class="metric-row"><strong>Slug</strong><span><%= article.slug || '' %></span></div><div class="metric-row"><strong>Meta title</strong><span><%= article.meta_title || '' %></span></div><div class="metric-row"><strong>Meta description</strong><span><%= article.meta_description || '' %></span></div><div class="metric-row"><strong>Image alt</strong><span><%= article.featured_image_alt || '' %></span></div><div class="metric-row"><strong>Published URL</strong><span><% if(article.published_url){ %><a target="_blank" href="<%= article.published_url %>"><%= article.published_url %></a><% } else { %>Not published<% } %></span></div></section><section class="card"><h2>Featured image</h2><% if(article.featured_image_url){ %><img class="hero-img" src="<%= article.featured_image_url %>" alt="" onerror="this.replaceWith(Object.assign(document.createElement('p'),{className:'empty',textContent:'Saved image file was not found. Re-upload the image from Edit Draft.'}))"><% } else { %><p class="empty">No image selected.</p><% } %></section></div>
<section class="card article-preview"><h2>Article body</h2><div class="rendered-article"><%- articleHtml || '' %></div></section><section class="card"><h2>Review notes</h2><pre style="white-space:pre-wrap;overflow:auto;max-height:280px"><%= article.review_notes || 'None' %></pre></section><section class="card"><h2>Schema JSON-LD</h2><pre style="white-space:pre-wrap;overflow:auto;max-height:280px"><%= article.schema_json || 'Not generated yet' %></pre></section><section class="card danger-zone"><h2>Actions</h2><div class="actions"><form method="post" action="/publish/<%= article.id %>"><input name="published_url" placeholder="Optional published URL"><button class="btn">Mark Published</button></form><form method="post" action="/articles/<%= article.id %>/delete" onsubmit="return confirm('Delete this article?')"><button class="btn danger">Delete</button></form></div></section>
<%- include('layout-end') %>
