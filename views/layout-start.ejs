<!doctype html>
<html lang="en" data-theme="<%= typeof userTheme !== 'undefined' ? userTheme : 'np-purple' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>NativPost SEO — Command Center</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..900;1,14..32,300..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/styles.css">
  <style>
  /* ── Enterprise Sidebar ─────────────────────────────────────────────────── */
  .sidebar {
    width: 256px; flex-shrink: 0; position: fixed; inset: 0 auto 0 0;
    background: linear-gradient(180deg, #080a0d 0%, #070810 100%);
    border-right: 1px solid rgba(134,79,254,.15);
    display: flex; flex-direction: column; z-index: 10;
    overflow-y: auto; overflow-x: hidden;
    transition: left .22s cubic-bezier(.4,0,.2,1);
  }
  .sidebar::before {
    content: ''; position: fixed; left: 0; top: 0; width: 256px; height: 3px;
    background: linear-gradient(90deg, transparent 0%, var(--np-purple) 40%, var(--np-cyan) 60%, transparent 100%);
    z-index: 11; pointer-events: none;
  }
  .main { margin-left: 256px; width: calc(100% - 256px); padding: var(--sp-6) var(--sp-7); max-width: 1600px; }

  /* Brand */
  .brand {
    display: flex; align-items: center; gap: 12px;
    padding: 22px 20px 18px;
    border-bottom: 1px solid rgba(134,79,254,.12);
    position: relative; flex-shrink: 0;
  }
  .brand::after {
    content: ''; position: absolute; bottom: -1px; left: 20px; right: 20px; height: 1px;
    background: linear-gradient(90deg, var(--np-purple) 0%, transparent 100%);
    opacity: 0.4;
  }
  .logo {
    width: 38px; height: 38px; flex-shrink: 0;
    border-radius: 50%;
    background: #1A1A1C;
    display: grid; place-items: center;
    box-shadow: 0 0 18px rgba(134,79,254,.35), 0 0 40px rgba(134,79,254,.12);
    animation: logo-pulse 4s ease-in-out infinite;
  }
  @keyframes logo-pulse {
    0%, 100% { box-shadow: 0 0 18px rgba(134,79,254,.35), 0 0 40px rgba(134,79,254,.12); }
    50% { box-shadow: 0 0 28px rgba(134,79,254,.55), 0 0 60px rgba(134,79,254,.2); }
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-text strong { color: #fff; font-weight: 800; font-size: 14px; letter-spacing: 0.06em; text-transform: uppercase; }
  .brand-text span { color: var(--np-purple); font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.22em; margin-top: 2px; opacity: .85; }

  /* Nav */
  nav { display: flex; flex-direction: column; padding: 8px 12px; flex: 1; gap: 1px; }

  .nav-section {
    margin-top: 16px; margin-bottom: 4px; padding: 0 8px;
    display: flex; align-items: center; gap: 8px;
  }
  .nav-section-line {
    flex: 1; height: 1px;
    background: linear-gradient(90deg, rgba(134,79,254,.3) 0%, rgba(134,79,254,.08) 100%);
  }
  .nav-section-label {
    font-size: 9px; font-weight: 800; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--np-purple); opacity: .7;
    white-space: nowrap; flex-shrink: 0;
  }
  .nav-section:first-child { margin-top: 6px; }

  nav a {
    color: rgba(165,176,184,.75);
    padding: 7px 10px;
    border-radius: 7px;
    font-size: 13px; font-weight: 500;
    display: flex; align-items: center; gap: 9px;
    border: 1px solid transparent;
    transition: all .15s ease;
    position: relative; letter-spacing: 0.01em;
  }
  nav a .nav-icon {
    width: 16px; height: 16px; flex-shrink: 0; opacity: .6;
    transition: opacity .15s ease;
  }
  nav a:hover {
    color: #e6ecee; background: rgba(255,255,255,.04);
    border-color: rgba(255,255,255,.06);
  }
  nav a:hover .nav-icon { opacity: .9; }
  nav a.active {
    color: var(--np-purple);
    background: linear-gradient(135deg, rgba(134,79,254,.15) 0%, rgba(134,79,254,.08) 100%);
    border-color: rgba(134,79,254,.25);
    font-weight: 600;
    box-shadow: inset 0 0 12px rgba(134,79,254,.06), 0 1px 4px rgba(0,0,0,.3);
  }
  nav a.active .nav-icon { opacity: 1; }
  nav a.active::before {
    content: ''; position: absolute; left: -1px; top: 20%; bottom: 20%;
    width: 2px; border-radius: 0 2px 2px 0;
    background: var(--np-purple);
    box-shadow: 0 0 8px var(--np-purple);
  }

  /* Sidebar footer */
  .sidebar-footer {
    margin-top: auto; padding: 14px 12px;
    border-top: 1px solid rgba(134,79,254,.12); flex-shrink: 0;
    display: flex; flex-direction: column; gap: 10px;
  }
  .sidebtn {
    width: 100%; padding: 10px 12px;
    border-radius: 8px; border: 1px solid rgba(255,255,255,.1);
    background: rgba(255,255,255,.03); color: rgba(165,176,184,.85);
    font-family: inherit; font-size: 12px; font-weight: 600;
    cursor: pointer; transition: all .15s ease; text-align: center;
    letter-spacing: 0.02em;
  }
  .sidebtn:hover {
    border-color: rgba(134,79,254,.5); color: var(--np-purple);
    background: rgba(134,79,254,.08);
    box-shadow: 0 0 12px rgba(134,79,254,.15);
  }
  .sidebtn small { display: block; font-size: 10px; opacity: .5; font-weight: 400; margin-top: 2px; }

  .sidebar-user {
    display: flex; justify-content: space-between; align-items: center;
    gap: 8px; padding: 8px 10px;
    background: rgba(255,255,255,.03); border-radius: 8px;
    border: 1px solid rgba(255,255,255,.07);
  }
  .sidebar-user-info { display: flex; flex-direction: column; gap: 2px; }
  .sidebar-user-name { font-size: 12px; color: #e6ecee; font-weight: 600; }
  .sidebar-user-info a { font-size: 10px; color: var(--text-muted); }
  .sidebar-logout { font-size: 11px; color: var(--text-muted); padding: 4px 8px; border-radius: 5px; border: 1px solid rgba(255,255,255,.1); transition: all .15s; }
  .sidebar-logout:hover { color: var(--bad); border-color: rgba(255,71,87,.4); background: rgba(255,71,87,.06); }
  </style>
</head>
<body data-theme="<%= typeof userTheme !== 'undefined' ? userTheme : 'np-purple' %>">

<!-- Mobile hamburger button -->
<button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation" onclick="toggleSidebar()">
  <span></span>
  <span></span>
  <span></span>
</button>

<!-- Overlay (click to close sidebar on mobile) -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<div class="app">
