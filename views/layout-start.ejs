  <div class="sidebar-footer">
    <form method="post" action="/maintenance/run-all" onsubmit="return confirm('Crawl &amp; Audit Sites?\n\nRe-scans your sites and competitors for technical SEO data.\nNo AI credits used. No content generated. No publishing.')">
      <button class="sidebtn" title="Crawls own sites and competitors — no OpenAI, no DataForSEO credits, no publishing">
        Crawl &amp; Audit Sites
        <small>No credits used</small>
      </button>
    </form>
    <div class="sidebar-user">
      <div class="sidebar-user-info">
        <span class="sidebar-user-name"><%= (typeof currentUser !== 'undefined' && currentUser) ? currentUser.username : 'Guest' %></span>
        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
          <a href="/admin/users">Manage users</a>
        <% } else { %>
          <a href="/settings">Settings</a>
        <% } %>
      </div>
      <a href="/auth/logout" class="sidebar-logout">Sign out</a>
    </div>
  </div>
</aside>
<main class="main">

