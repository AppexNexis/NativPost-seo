    <div class="nav-section">
      <span class="nav-section-label">Content</span>
      <span class="nav-section-line"></span>
    </div>
    <a class="<%= currentPath==='/content-studio'?'active':'' %>" href="/content-studio">
      <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 2.5a1.5 1.5 0 0 1 2.5 1.5L5 12.5 2 13.5l1-3L11 2.5z"/></svg>
