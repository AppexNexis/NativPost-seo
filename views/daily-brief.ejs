<%- include('layout-start') %>
<section class="hero">
  <div>
    <p class="eyebrow">Generated <%= today %></p>
    <h1>Daily SEO Brief</h1>
    <p>Smart article recommendations ranked by ranking impact. Based on your live GSC data, competitor gaps, game coverage, and keyword opportunities.</p>
  </div>
  <div class="actions">
    <form method="post" action="/daily-brief/refresh">
      <button class="btn">Refresh Brief</button>
    </form>
    <a class="btn primary" href="/content-studio">Content Studio →</a>
  </div>
</section>

<% if(typeof summary !== 'undefined' && summary){ %>
<div style="background:rgba(134,79,254,.06);border:1px solid rgba(134,79,254,.15);border-radius:10px;padding:12px 18px;margin-bottom:1.5rem;font-size:.85rem;color:var(--text-muted)">
  <strong style="color:var(--np-purple)">Today's analysis:</strong> <%= summary %>
  <% if(generatedAt){ %> &nbsp;·&nbsp; Generated at <%= new Date(generatedAt).toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'}) %><% } %>
</div>
<% } %>

<% if(!brief || !brief.length){ %>
<section class="card">
  <p class="empty">No recommendations yet. Sync GSC, crawl competitors, and run auto-detect on Platform Strategy — then the brief will generate automatically each morning.</p>
</section>
<% } else { %>

<div style="display:flex;flex-direction:column;gap:16px">
  <% brief.forEach(function(rec, i){ %>
  <%
    var catColor = rec.category === 'ranking-gap' ? '#864FFE' :
                   rec.category === 'game-coverage' ? '#4aff66' :
                   rec.category === 'competitor-gap' ? '#ffb020' :
                   rec.category === 'topical-depth' ? '#3db4ff' : '#a5b0b8';
    var catLabel = rec.category === 'ranking-gap' ? '📈 Ranking Gap' :
                   rec.category === 'game-coverage' ? '🎮 Game Coverage' :
                   rec.category === 'competitor-gap' ? '⚔️ Competitor Gap' :
                   rec.category === 'topical-depth' ? '📚 Topical Depth' : '🔑 Keyword';
  %>
  <div style="background:var(--bg-2,#0d1117);border:1px solid var(--line,#1e242c);border-radius:12px;padding:20px 22px;display:flex;gap:20px;align-items:flex-start;transition:border-color .15s"
       onmouseover="this.style.borderColor='rgba(134,79,254,.25)'" onmouseout="this.style.borderColor='var(--line,#1e242c)'">
    <div style="flex-shrink:0;width:36px;height:36px;border-radius:8px;background:rgba(134,79,254,.1);border:1px solid rgba(134,79,254,.2);display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--np-purple);font-size:14px">
      <%= i+1 %>
    </div>
    <div style="flex:1;min-width:0">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px">
        <span style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;padding:3px 10px;border-radius:20px;background:rgba(134,79,254,.08);color:<%= catColor %>;border:1px solid <%= catColor %>44"><%= catLabel %></span>
        <span style="font-size:.72rem;color:var(--text-muted)">Score: <%= rec.score %></span>
      </div>
      <h3 style="font-size:1.05rem;font-weight:700;color:var(--text,#e6ecee);margin-bottom:8px;word-break:break-word"><%= rec.keyword %></h3>
      <p style="font-size:.82rem;color:var(--text-muted);line-height:1.55;margin-bottom:12px"><%= rec.reason %></p>
      <% if(rec.evidence && rec.evidence.length){ %>
      <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px">
        <% rec.evidence.forEach(function(e){ %>
        <span style="font-size:.72rem;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:6px;padding:2px 8px;color:var(--text-muted)"><%= e %></span>
        <% }); %>
      </div>
      <% } %>
      <form method="post" action="/daily-brief/generate/<%= i %>">
        <button class="btn primary" style="font-size:.8rem;padding:7px 16px" onclick="return confirm('Generate article? Uses 1 AI credit.')">
          Generate Article →
        </button>
      </form>
    </div>
  </div>
  <% }); %>
</div>

<% } %>

<%- include('layout-end') %>
