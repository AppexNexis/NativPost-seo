<%- include('layout-start') %>

<section class="hero">
  <div>
    <p class="eyebrow">Admin</p>
    <h1>Keyword Opportunity Radar</h1>
    <p>Auto-detected keyword opportunities for NativPost — pulled from competitor crawls, SERP data, and keyword gap analysis. These feed the 30-day content plan.</p>
  </div>
</section>

<div class="grid two" style="align-items:start">
  <section class="card">
    <div class="card-head"><h2>Top Opportunities</h2><a href="/keywords">All keywords →</a></div>
    <% if (!gameRecommendations || !gameRecommendations.length) { %>
      <p class="empty">No opportunities detected yet. Audit competitors and run SERP lookups to populate this.</p>
      <div class="hint" style="margin-top:var(--sp-3)">
        How to generate opportunities:<br>
        1. Go to <a href="/competitors">Competitors</a> → Audit all<br>
        2. Go to <a href="/serp">SERP Intelligence</a> → Look up core keywords<br>
        3. Come back here — opportunities auto-populate from those two sources
      </div>
    <% } else { %>
      <% gameRecommendations.slice(0,20).forEach(function(r) { %>
      <div class="metric-row">
        <div>
          <strong style="font-size:var(--fs-md)"><%= r.game || r.keyword || 'Keyword opportunity' %></strong>
          <span style="font-size:var(--fs-xs);color:var(--text-muted)"><%= r.reason || r.source || '' %></span>
        </div>
        <% if (r.score) { %><span class="badge"><%= r.score %></span><% } %>
      </div>
      <% }); %>
    <% } %>
  </section>

  <section class="card">
    <div class="card-head"><h2>How the Radar Works</h2></div>
    <div style="display:flex;flex-direction:column;gap:10px;font-size:var(--fs-sm);color:var(--text-muted)">
      <div><strong style="color:var(--text-heading)">Competitor crawl</strong><br>When competitors are audited, their page titles and meta descriptions are analysed for keywords NativPost hasn't covered yet.</div>
      <div><strong style="color:var(--text-heading)">SERP lookups</strong><br>Every SERP result you run feeds keyword gaps into this radar — especially when competitors rank but NativPost doesn't.</div>
      <div><strong style="color:var(--text-heading)">GSC sync</strong><br>After syncing Google Search Console, queries with impressions but no article create automatic radar entries.</div>
      <div><strong style="color:var(--text-heading)">Content plan</strong><br>The 30-day plan in Content Studio pulls directly from this radar. High-score opportunities get prioritised first.</div>
    </div>
    <div style="margin-top:var(--sp-4);display:flex;gap:var(--sp-2)">
      <a href="/competitors" class="btn">Audit Competitors</a>
      <a href="/serp" class="btn">SERP Lookups</a>
    </div>
  </section>
</div>

<%- include('layout-end') %>
