<%- include('layout-start') %>
<section class="hero">
  <div>
    <p class="eyebrow">Competitor intelligence</p>
    <h1>Competitors</h1>
    <p>Track competitor sites. The crawler extracts their pages, content topics, keyword gaps, and linking domains — feeding directly into your content strategy.</p>
  </div>
  <div class="actions">
    <form method="post" action="/competitors/audit-all" onsubmit="return confirm('Re-crawl all competitors? This uses HTTP crawling only — no credits.')">
      <button class="btn primary">Re-audit all</button>
    </form>
  </div>
</section>

<section class="card">
  <h2>Add competitor</h2>
  <form class="stack" method="post" action="/competitors">
    <div class="grid two" style="gap:10px">
      <label>Competitor URL
        <input name="url" placeholder="https://nitrado.net" required>
      </label>
      <label>Display name
        <input name="name" placeholder="Nitrado (optional)">
      </label>
      <label>Compare to site
        <select name="site_id">
          <option value="">All sites</option>
          <% sites.forEach(function(s){ %><option value="<%= s.id %>"><%= s.name %></option><% }); %>
        </select>
      </label>
    </div>
    <button class="btn primary" style="width:auto">Add &amp; crawl</button>
  </form>
</section>

<% if(!competitors.length){ %>
  <section class="card"><p class="empty">No competitors yet. Add a competitor URL above to start tracking.</p></section>
<% } %>

<% if(competitors.length){ %>
<section class="card">
  <div class="card-head"><h2>Tracked competitors (<%= competitors.length %>)</h2></div>
  <table style="width:100%;border-collapse:collapse;font-size:var(--fs-sm)">
    <thead>
      <tr style="border-bottom:1px solid var(--line);text-align:left">
        <th style="padding:.4rem .5rem">Competitor</th>
        <th style="padding:.4rem .5rem">Score</th>
        <th style="padding:.4rem .5rem">Pages</th>
        <th style="padding:.4rem .5rem">Content</th>
        <th style="padding:.4rem .5rem">Keywords</th>
        <th style="padding:.4rem .5rem">Ext. domains</th>
        <th style="padding:.4rem .5rem">Last scan</th>
        <th style="padding:.4rem .5rem"></th>
      </tr>
    </thead>
    <tbody>
    <% var _maxScore = Math.max.apply(null, competitors.map(function(c){ return Number(c.audit_score||0); }).concat([1])); %>
    <% competitors.forEach(function(c){ %>
      <% var snap = null; try { snap = c.snapshot_json ? JSON.parse(c.snapshot_json) : null; } catch(e){} %>
      <tr style="border-bottom:1px solid rgba(255,255,255,.05)">
        <td style="padding:.5rem .5rem">
          <strong><a href="/competitors/<%= c.id %>"><%= c.name||c.url %></a></strong>
          <span style="display:block;color:var(--text-muted);font-size:var(--fs-sm)"><%= c.url %></span>
          <% if(snap && snap.error){ %><span style="color:var(--bad);font-size:var(--fs-xs)"><%= snap.error.slice(0,60) %></span><% } %>
        </td>
        <td style="padding:.5rem .5rem">
          <div style="display:flex;align-items:center;gap:8px">
            <div style="flex:1;background:var(--line);border-radius:var(--r-sm);height:6px;min-width:60px">
              <div style="height:100%;border-radius:var(--r-sm);background:linear-gradient(90deg,var(--np-purple),var(--info));width:<%= Math.max(2,Math.round(Number(c.audit_score||0)/_maxScore*100)) %>%"></div>
            </div>
            <strong><%= Math.round(Number(c.audit_score||0)) %></strong>
          </div>
        </td>
        <td style="padding:.5rem .5rem;color:var(--text-muted)"><%= snap ? (snap.indexablePages||0) : '—' %></td>
        <td style="padding:.5rem .5rem;color:var(--text-muted)"><%= snap ? (snap.contentPages||0) : '—' %></td>
        <td style="padding:.5rem .5rem;color:var(--text-muted)"><%= snap ? (snap.keywordCount||0) : '—' %></td>
        <td style="padding:.5rem .5rem;color:var(--text-muted)"><%= snap ? (snap.externalDomains||0) : '—' %></td>
        <td style="padding:.5rem .5rem;color:var(--text-muted);font-size:var(--fs-sm)"><%= c.last_audited_at ? new Date(c.last_audited_at).toLocaleDateString() : 'Never' %></td>
        <td style="padding:.5rem .5rem">
          <div class="actions">
            <a class="mini" href="/competitors/<%= c.id %>">View</a>
            <form method="post" action="/competitors/<%= c.id %>/audit">
              <button class="mini">Re-crawl</button>
            </form>
            <form method="post" action="/competitors/<%= c.id %>/delete" onsubmit="return confirm('Remove this competitor?')">
              <button class="mini danger">Remove</button>
            </form>
          </div>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table>
</section>
<% } %>
<%- include('layout-end') %>
